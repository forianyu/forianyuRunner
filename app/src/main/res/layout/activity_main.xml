<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_top"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Clock -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/currentTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00:00"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/waiting_for_gps"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Distance + elapsed time: kept close under the clock rather than
             floating in the middle of the screen. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/distanceValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textColor="@color/text_primary"
                    android:textSize="54sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/distanceUnitText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/distance_unit"
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/timeValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="00:00:00"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Previous-stage / current-stage comparison, one row each. Only
             shown while tracking - see MainActivity.updateStageDisplay(). -->
        <LinearLayout
            android:id="@+id/stageCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView style="@style/StageHeadFirst" android:text="@string/stage_col_label" />
                <TextView style="@style/StageHead" android:text="@string/stage_col_start" />
                <TextView style="@style/StageHead" android:text="@string/stage_col_end" />
                <TextView style="@style/StageHead" android:text="@string/stage_col_duration" />
                <TextView style="@style/StageHead" android:text="@string/stage_col_distance" />
                <TextView style="@style/StageHead" android:text="@string/stage_col_speed" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prevStageRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    style="@style/StageCellFirst"
                    android:text="@string/stage_prev_label"
                    android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/prevStageStartText" style="@style/StageCell" />
                <TextView android:id="@+id/prevStageEndText" style="@style/StageCell" />
                <TextView android:id="@+id/prevStageDurationText" style="@style/StageCell" />
                <TextView android:id="@+id/prevStageDistanceText" style="@style/StageCell" />
                <TextView android:id="@+id/prevStageSpeedText" style="@style/StageCell" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/currentStageRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_stage_current"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    style="@style/StageCellFirst"
                    android:text="@string/stage_current_label"
                    android:textColor="@color/accent" />
                <TextView
                    android:id="@+id/currentStageStartText"
                    style="@style/StageCell"
                    android:textColor="@color/accent" />
                <TextView
                    style="@style/StageCell"
                    android:text="@string/stage_in_progress"
                    android:textColor="@color/accent" />
                <TextView
                    android:id="@+id/currentStageDurationText"
                    style="@style/StageCell"
                    android:textColor="@color/accent" />
                <TextView
                    android:id="@+id/currentStageDistanceText"
                    style="@style/StageCell"
                    android:textColor="@color/accent" />
                <TextView
                    android:id="@+id/currentStageSpeedText"
                    style="@style/StageCell"
                    android:textColor="@color/accent" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Everything else, as a compact label/value table. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/weight_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/weightInput"
                    android:layout_width="52dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_pill_stroke"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/weight_unit"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <View style="@style/TableDivider" />

            <LinearLayout style="@style/TableRow">

                <TextView
                    style="@style/TableLabel"
                    android:text="@string/avg_speed_label" />

                <TextView
                    android:id="@+id/avgSpeedValueText"
                    style="@style/TableValue"
                    android:text="0.0 km/h" />
            </LinearLayout>

            <View style="@style/TableDivider" />

            <LinearLayout style="@style/TableRow">

                <TextView
                    style="@style/TableLabel"
                    android:text="@string/overall_avg_speed_label" />

                <TextView
                    android:id="@+id/overallAvgSpeedValueText"
                    style="@style/TableValue"
                    android:textColor="@color/accent"
                    android:text="-" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomButtonRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextStageButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="130dp"
            android:layout_height="56dp"
            android:layout_marginEnd="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/next_stage"
            android:textSize="15sp"
            android:textColor="@color/accent"
            android:visibility="gone"
            app:cornerRadius="28dp"
            app:strokeColor="@color/accent"
            app:strokeWidth="1.5dp"
            app:rippleColor="@color/accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/start"
            android:textSize="20sp"
            android:textColor="@color/bg_top"
            app:backgroundTint="@color/accent"
            app:cornerRadius="60dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
